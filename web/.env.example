# Copy to .env.local and adjust. NEXT_PUBLIC_* values are baked in at build time.

# FastAPI backend (on Vercel: your Render address, e.g. https://teleco-tutor-api.onrender.com)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase. Leave both empty for local dev mode (no passwords, pick a test user name;
# the backend must then run without SUPABASE_URL).
# Project URL + the PUBLISHABLE key (sb_publishable_...). Never the secret / service_role key.
# NEXT_PUBLIC_SUPABASE_URL=https://ivmtsaeldwzxbiyalkqk.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_gFK3B3V9Vo1bd8lCB8pRJg_Um13qkv9
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
