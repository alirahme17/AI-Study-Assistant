# Copy to .env.local and adjust. NEXT_PUBLIC_* values are baked in at build time.

# FastAPI backend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase (leave empty for local dev mode: no passwords, pick a workspace name;
# the backend must then run with AUTH_MODE=dev).
# Project Settings -> API: Project URL and the publishable/anon key (never the service_role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
