# Backend configuration. Copy to backend/.env for local development (never commit .env).
# On Render, set these in the service's Environment tab instead.

# --- Database: Supabase -> Project Settings -> Database -> Connection string ->
#     "Transaction pooler" (port 6543). Contains the database password: keep it secret.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Sign-in + file storage
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase -> Project Settings -> API Keys -> "secret" key (sb_secret_...). Server only!
SUPABASE_SERVICE_KEY=
STORAGE_BACKEND=supabase
STORAGE_BUCKET=pdfs

# --- Encrypts users' Gemini keys in the database. Generate once, keep it forever:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- The web app's address (comma-separated if several)
CORS_ORIGINS=http://localhost:3000

# --- Optional
# GEMINI_MODEL=gemini-3.8-flash          # writes the answers
# OCR_MODEL=gemini-3.5-flash-lite        # reads scanned / handwritten pages (OCR=none to disable)
# MAX_UPLOAD_MB=50

# --- Local development without Supabase (dev sign-in via X-Dev-User, files in ./storage):
# DATABASE_URL=postgresql://postgres@localhost:5432/tutor
# STORAGE_BACKEND=local
# (leave SUPABASE_URL empty)  EMBEDDINGS=fake  OCR=none  FAKE_LLM=1  for fully offline demos
